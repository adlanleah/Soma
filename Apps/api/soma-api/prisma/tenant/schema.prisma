generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/tenant-client"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  TEACHER
  STUDENT
  PARENT
}

enum AdminLevel {
  PRINCIPAL   // Headteacher / Deputy — full access, only one that can invite other admins
  STAFF       // Bursar / Secretary / IT Coordinator — manages users, cohorts, courses
  ACADEMIC    // Director of Studies — manages curriculum, teacher assignments, analytics
}

model User {
  id           String   @id @default(uuid())
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole
  status       String   @default("pending")

  adminProfile   AdminProfile?
  studentProfile StudentProfile?
  teacherProfile TeacherProfile?
  parentLinks    ParentStudentLink[] @relation("ParentLinks")

  invitations UserInvitation[]

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model AdminProfile {
  id         String     @id @default(uuid())
  userId     String     @unique @map("user_id")
  user       User       @relation(fields: [userId], references: [id])
  adminLevel AdminLevel @map("admin_level")
  title      String?    // e.g. "Headteacher", "Bursar", "Director of Studies"

  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  @@map("admin_profiles")
}

model StudentProfile {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  user        User     @relation(fields: [userId], references: [id])
  grade       String
  ageGroup    String   @map("age_group")
  studentCode String   @unique @map("student_code")
  classId     String?  @map("class_id")
  class       Cohort?  @relation(fields: [classId], references: [id])

  @@map("student_profiles")
}

model TeacherProfile {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  @@map("teacher_profiles")
}

model ParentStudentLink {
  id        String @id @default(uuid())
  parentId  String @map("parent_id")
  parent    User   @relation("ParentLinks", fields: [parentId], references: [id])
  studentId String @map("student_id")

  @@map("parent_student_links")
}

model Cohort {
  id        String   @id @default(uuid())
  name      String
  endDate   DateTime @map("end_date")
  students  StudentProfile[]
  courses   Course[]
  createdAt DateTime @default(now()) @map("created_at")

  @@map("cohorts")
}

model Course {
  id          String  @id @default(uuid())
  name        String
  description String?
  cohortId    String? @map("cohort_id")
  cohort      Cohort? @relation(fields: [cohortId], references: [id])

  @@map("courses")
}

model UserInvitation {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")

  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("user_invitations")
}